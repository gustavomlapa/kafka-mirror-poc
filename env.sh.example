#!/usr/bin/env bash
# ==============================================================================
# Central Environment Configuration for Kafka MirrorMaker 2.0 POC
# Copy this file to 'env.sh' and adjust variables according to your GCP project.
#   cp env.sh.example env.sh
# ==============================================================================

# GCP Project & Region
export PROJECT_ID="${PROJECT_ID:-your-gcp-project-id}"
export REGION="${REGION:-us-central1}"
export ZONE="${ZONE:-us-central1-a}"

# Networking Configuration
export VPC_NAME="${VPC_NAME:-kafka-poc-vpc}"
export SUBNET_NAME="${SUBNET_NAME:-kafka-poc-subnet}"
export SUBNET_CIDR="${SUBNET_CIDR:-10.0.0.0/24}"

# Service Account for Kafka Clients, Cloud Run, and MirrorMaker 2 VM
export SERVICE_ACCOUNT_NAME="${SERVICE_ACCOUNT_NAME:-sa-kafka-poc}"
export SERVICE_ACCOUNT_EMAIL="${SERVICE_ACCOUNT_NAME}@${PROJECT_ID}.iam.gserviceaccount.com"

# Managed Service for Apache Kafka - Cluster 1 (Source)
export CLUSTER1_NAME="${CLUSTER1_NAME:-kafka-cluster1-source}"
export CLUSTER1_CPU="${CLUSTER1_CPU:-3}"
export CLUSTER1_MEMORY="${CLUSTER1_MEMORY:-3GiB}"

# Managed Service for Apache Kafka - Cluster 2 (Target)
export CLUSTER2_NAME="${CLUSTER2_NAME:-kafka-cluster2-target}"
export CLUSTER2_CPU="${CLUSTER2_CPU:-3}"
export CLUSTER2_MEMORY="${CLUSTER2_MEMORY:-3GiB}"

# Kafka Topic & Consumer Group Configurations
export TOPIC_NAME="${TOPIC_NAME:-orders-poc}"
export TOPIC_PARTITIONS="${TOPIC_PARTITIONS:-3}"
export TOPIC_REPLICATION_FACTOR="${TOPIC_REPLICATION_FACTOR:-3}"
export CONSUMER_GROUP="${CONSUMER_GROUP:-order-processing-group}"

# MirrorMaker 2.0 VM Configuration
export MM2_VM_NAME="${MM2_VM_NAME:-kafka-mm2-vm}"
export MM2_MACHINE_TYPE="${MM2_MACHINE_TYPE:-e2-standard-4}"
export KAFKA_VERSION="${KAFKA_VERSION:-3.7.1}"
export SCALA_VERSION="${SCALA_VERSION:-2.13}"
export GCP_AUTH_HANDLER_VERSION="${GCP_AUTH_HANDLER_VERSION:-1.0.6}"

# Cloud Run & Artifact Registry Configuration
export ARTIFACT_REPO_NAME="${ARTIFACT_REPO_NAME:-kafka-poc-repo}"
export PRODUCER_SERVICE_NAME="${PRODUCER_SERVICE_NAME:-kafka-producer-service}"
export CONSUMER_SERVICE_NAME="${CONSUMER_SERVICE_NAME:-kafka-consumer-service}"
